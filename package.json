{
  "name": "yt-transcript",
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "build": "astro build",
    "dev": "astro dev",
    "start": "npm run build && node server.js",
    "serve": "node server.js",
    "test": "npm run build && node --test \"tests/*.test.js\"",
    "test:only": "node --test \"tests/*.test.js\"",
    "digest:aitell": "node tools/ai-tell/score-digests.mjs",
    "tauri": "tauri",
    "tauri:dev": "tauri dev",
    "tauri:build": "node tools/tauri-build.mjs",
    "pkg:stage-deps": "node tools/stage-deps.mjs",
    "digest:fidelity": "node tools/fidelity/score-fidelity.mjs",
    "digest:ab": "node tools/ab-compare.mjs",
    "test:page": "node tests/e2e/page-smoke.mjs",
    "test:extension": "node extension/test/e2e.mjs",
    "serve:public": "node --env-file-if-exists=.env.local tools/holesail-serve.mjs"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.109.1",
    "express": "^4.19.2",
    "youtube-transcript": "^1.2.1"
  },
  "devDependencies": {
    "@tauri-apps/api": "^2.11.1",
    "@tauri-apps/cli": "^2.11.4",
    "astro": "^7.2.0",
    "holesail-server": "^2.4.0"
  },
  "engines": {
    "node": ">=22.12"
  }
}
