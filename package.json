{
  "name": "yt-transcript",
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "build": "astro build",
    "dev": "astro dev",
    "start": "npm run build && node server.js",
    "serve": "node server.js",
    "test": "npm run build && node --test \"tests/*.test.js\"",
    "test:only": "node --test \"tests/*.test.js\"",
    "digest:aitell": "node tools/ai-tell/score-digests.mjs",
    "tauri": "tauri",
    "tauri:dev": "tauri dev",
    "tauri:build": "npm run pkg:stage-deps && NO_STRIP=1 APPIMAGE_EXTRACT_AND_RUN=1 tauri build",
    "pkg:stage-deps": "rm -rf src-tauri/dist-deps && mkdir -p src-tauri/dist-deps && cp package.json package-lock.json src-tauri/dist-deps/ && npm install --omit=dev --ignore-scripts --no-audit --no-fund --prefix src-tauri/dist-deps && rm -f src-tauri/dist-deps/package.json src-tauri/dist-deps/package-lock.json",
    "digest:fidelity": "node tools/fidelity/score-fidelity.mjs",
    "test:page": "node tests/e2e/page-smoke.mjs",
    "serve:public": "node tools/holesail-serve.mjs"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.109.1",
    "express": "^4.19.2",
    "youtube-transcript": "^1.2.1"
  },
  "devDependencies": {
    "@tauri-apps/api": "^2.11.1",
    "@tauri-apps/cli": "^2.11.4",
    "astro": "^7.2.0",
    "cookie": "^2.0.1",
    "holesail-server": "^2.4.0"
  },
  "engines": {
    "node": ">=22.12"
  }
}
