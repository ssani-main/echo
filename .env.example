# Echo — environment variables
#
# Copy to .env for local use, or set these directly in your hosting platform.
# None are required to run locally (`npm start`) — every default below
# preserves current local/desktop behaviour.

# --- Mode -------------------------------------------------------------------

# 'local' (default) or 'web'. 'web' enables BYOK (bring-your-own-key) mode,
# rate limiting, payload/transcript size caps, and disables server-side
# library/search persistence. Only set this to 'web' for a hosted deployment.
ECHO_MODE=local

# Interface to bind to. Defaults to 127.0.0.1 (not reachable from the
# network) for safety in local/desktop use. Set to 0.0.0.0 to accept
# connections from outside the container/host (needed behind a reverse proxy).
ECHO_HOST=127.0.0.1

# Port to listen on.
PORT=8000

# --- AI provider --------------------------------------------------------

# Which summarization provider to use.
#   unset / 'cli'   the local `claude` CLI (default — no key, no billing setup)
#   'api'           the Anthropic API (also spelled 'anthropic')
#   'deepseek'      the DeepSeek API (OpenAI-compatible)
# 'cli' and 'api' keep working: they are the names that existed before there was
# a registry, and renaming them would break every existing .env. A per-request
# X-Echo-Provider header overrides this — that is what the in-app provider picker
# sends — and a per-request key with no provider named still means Anthropic,
# exactly as it always did.
ECHO_PROVIDER=cli

# Fallback Anthropic API key used by ApiKeyProvider when no per-request key
# is supplied (e.g. local testing of the API provider path). Never required
# in ECHO_MODE=web — hosted requests must bring their own key.
ANTHROPIC_API_KEY=

# --- DeepSeek (optional) --------------------------------------------------
# A second BYOK provider, chosen per request by the picker in Settings/Options
# or globally via ECHO_PROVIDER=deepseek. Nothing here is needed to run Echo.

# Key for the DeepSeek provider. Used when the request brings no key of its own.
ECHO_DEEPSEEK_API_KEY=

# Model id sent to DeepSeek. Defaults to 'deepseek-flash', which IS
# DeepSeek-V4.1-Flash (the wire id and the display name differ). The legacy ids
# 'deepseek-v4-flash' and 'deepseek-v4-flash-vision-exp' are still accepted and
# are served by V4.1 Flash. 'deepseek-v4-pro' also routes to V4.1 Flash as of
# 2026-09-14. The OpenAI-era alias 'deepseek-chat' is NOT accepted.
ECHO_DEEPSEEK_MODEL=

# Base URL, for pointing Echo at a proxy in front of DeepSeek.
# Defaults to https://api.deepseek.com
ECHO_DEEPSEEK_BASE_URL=

# DeepSeek's context window in tokens, which is what decides where the digest
# switches to map-reduce. Defaults to 1000000. Lower it to match the endpoint
# you actually point at — a context number larger than the truth means a long
# transcript is sent whole and comes back rejected.
ECHO_DEEPSEEK_CONTEXT_TOKENS=

# max_tokens for DeepSeek calls. Defaults to 384000 (the model's stated maximum,
# and a value the live API accepted). It is SENT, not omitted: leaving it unset
# hands the ceiling to the API's default, which is far below the model's maximum
# and silently truncated an `article`-mode digest at 6552 words during the
# provider A/B. Truncation is detected either way from finish_reason, but not
# truncating beats reporting that you did.
ECHO_DEEPSEEK_MAX_OUTPUT_TOKENS=384000

# How long one digest call may run before it is killed, in ms. Default 180000.
# Raise it only if you need to: the provider A/B measured an `article`-mode digest
# of a 71 627-char transcript at 185s — just past the default — while `digest`
# mode peaked at 64s on the same corpus. The default is a genuine hang detector,
# so this is a real trade-off rather than a bug.
ECHO_DIGEST_TIMEOUT_MS=

# Escape hatch for an unverified parameter. Echo sends thinking:{type:'disabled'}
# when reasoning is off, so that "off" actually means off. DeepSeek's docs
# document {type:'enabled'}; that the same object accepts 'disabled' is a strong
# convention rather than a documented fact. If this API rejects it, set this to
# 'omit' and Echo will leave the field out entirely instead.
ECHO_DEEPSEEK_THINKING_FIELD=

# --- Reasoning ("thinking") -----------------------------------------------
# One shared level, translated per provider, so two providers can be compared
# without the reasoning mode being a hidden second variable.
#   off (default) · low · medium · high    ('on' is accepted and means high)
# Off is the default for EVERY provider, and it is SENT rather than omitted —
# leaving it out would let each API's own default apply, and if those defaults
# differ then a comparison between them measures the difference in defaults.
#
# Per provider: Anthropic takes a token budget (Echo's mapping: 2k/4k/8k, or
# ECHO_THINKING_BUDGET_TOKENS); DeepSeek takes reasoning_effort. The local CLI
# has no such concept and is unaffected.
#
# Note this interacts with truncation: reasoning tokens are counted as OUTPUT
# tokens, so turning this up brings the output ceiling closer. On Anthropic the
# budget also comes out of the same 16 000-token ceiling as the digest itself.
ECHO_THINKING=off

# Overrides the Anthropic budget for whichever level is selected. Clamped to the
# API's valid range (>= 1024 and strictly below max_tokens) rather than trusted,
# because an out-of-range budget is a hard 400.
ECHO_THINKING_BUDGET_TOKENS=

# --- Web-mode abuse / cost guards (no-ops unless ECHO_MODE=web) -------------

# Max transcript length (characters) accepted before rejecting the request.
ECHO_MAX_TRANSCRIPT_CHARS=200000

# Max text/segments payload size (characters) accepted by AI endpoints.
ECHO_MAX_AI_PAYLOAD_CHARS=200000

# --- Usage meter (data/usage-events.jsonl, local-only) ----------------------

# Set to seed synthetic/benchmark data (e.g. library scale-sweep scripts)
# without polluting the real usage meter. Every event logged while this is
# set is stamped `synthetic:true`; usage_stats.mjs excludes those records.
# Leave unset for normal use — every real user action should be unflagged.
ECHO_USAGE_SYNTHETIC=

# Size (bytes) at which data/usage-events.jsonl rotates to
# usage-events.1.jsonl (one backup generation kept). Default 10 MB.
ECHO_USAGE_ROTATE_BYTES=10000000

# Where the usage log is written. Mainly a test/isolation seam (mirrors
# ECHO_DB_PATH); leave unset for normal use.
ECHO_USAGE_LOG_PATH=

# --- Storage / models ---------------------------------------------------

# Path to the SQLite database file (the local/desktop library DB). Unused in
# ECHO_MODE=web, which keeps the library client-side in IndexedDB.
ECHO_DB_PATH=./data/library.db

# --- Accounts + library sync (web mode only; entirely optional) -------------

# Sign in with Google so a library follows you between devices. All THREE of
# the vars below must be set for accounts to switch on; with any of them unset
# the sign-in UI never appears, no database is created, and hosted Echo behaves
# exactly as it does today (library in the browser, no account).
#
# Create an OAuth client at https://console.cloud.google.com/apis/credentials
# (type: Web application) and add <your public URL>/api/auth/callback as an
# authorised redirect URI.
#
# Signing in does NOT change where your Anthropic key lives. Keys stay in the
# browser and ride per-request in X-Echo-Api-Key; the server never stores one.
ECHO_GOOGLE_CLIENT_ID=
ECHO_GOOGLE_CLIENT_SECRET=

# Secret used to sign session cookies. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
# Changing it signs everybody out; there is no other effect.
ECHO_SESSION_SECRET=

# Public origin, used to build the OAuth redirect URI Google matches against
# its allow-list. Falls back to the request's own origin, which is wrong behind
# some proxies — set it explicitly for a real deployment.
ECHO_PUBLIC_URL=

# Where the sync database lives. Needs to be on a persistent volume; this is
# the ONLY server-side state Echo has.
ECHO_SYNC_DB_PATH=/data/echo-sync.db

# Per-account storage ceiling for the synced library, in bytes.
ECHO_MAX_SYNC_BYTES=100000000
