# Echo — environment variables
#
# Copy to .env for local use, or set these directly in your hosting platform.
# None are required to run locally (`npm start`) — every default below
# preserves current local/desktop behaviour.

# --- Mode -------------------------------------------------------------------

# 'local' (default) or 'web'. 'web' enables BYOK (bring-your-own-key) mode,
# rate limiting, payload/transcript size caps, and disables server-side
# library/search persistence. Only set this to 'web' for a hosted deployment.
ECHO_MODE=local

# Interface to bind to. Defaults to 127.0.0.1 (not reachable from the
# network) for safety in local/desktop use. Set to 0.0.0.0 to accept
# connections from outside the container/host (needed behind a reverse proxy).
ECHO_HOST=127.0.0.1

# Port to listen on.
PORT=8000

# --- AI provider --------------------------------------------------------

# Which summarization provider to use: unset/'cli' (default, wraps the local
# `claude` CLI) or 'api' (talks directly to the Anthropic API via
# @anthropic-ai/sdk). In ECHO_MODE=web, requests always use ApiKeyProvider via
# the per-request X-Echo-Api-Key header regardless of this setting.
ECHO_PROVIDER=cli

# Fallback Anthropic API key used by ApiKeyProvider when no per-request key
# is supplied (e.g. local testing of the API provider path). Never required
# in ECHO_MODE=web — hosted requests must bring their own key.
ANTHROPIC_API_KEY=

# --- Web-mode abuse / cost guards (no-ops unless ECHO_MODE=web) -------------

# Max transcript length (characters) accepted before rejecting the request.
ECHO_MAX_TRANSCRIPT_CHARS=200000

# Max text/segments payload size (characters) accepted by AI endpoints.
ECHO_MAX_AI_PAYLOAD_CHARS=200000

# --- Usage meter (data/usage-events.jsonl, local-only) ----------------------

# Set to seed synthetic/benchmark data (e.g. library scale-sweep scripts)
# without polluting the real usage meter. Every event logged while this is
# set is stamped `synthetic:true`; usage_stats.mjs excludes those records.
# Leave unset for normal use — every real user action should be unflagged.
ECHO_USAGE_SYNTHETIC=

# Size (bytes) at which data/usage-events.jsonl rotates to
# usage-events.1.jsonl (one backup generation kept). Default 10 MB.
ECHO_USAGE_ROTATE_BYTES=10000000

# Where the usage log is written. Mainly a test/isolation seam (mirrors
# ECHO_DB_PATH); leave unset for normal use.
ECHO_USAGE_LOG_PATH=

# --- Storage / models ---------------------------------------------------

# Path to the SQLite database file (the local/desktop library DB). Unused in
# ECHO_MODE=web, which keeps the library client-side in IndexedDB.
ECHO_DB_PATH=./data/library.db

# --- Accounts + library sync (web mode only; entirely optional) -------------

# Sign in with Google so a library follows you between devices. All THREE of
# the vars below must be set for accounts to switch on; with any of them unset
# the sign-in UI never appears, no database is created, and hosted Echo behaves
# exactly as it does today (library in the browser, no account).
#
# Create an OAuth client at https://console.cloud.google.com/apis/credentials
# (type: Web application) and add <your public URL>/api/auth/callback as an
# authorised redirect URI.
#
# Signing in does NOT change where your Anthropic key lives. Keys stay in the
# browser and ride per-request in X-Echo-Api-Key; the server never stores one.
ECHO_GOOGLE_CLIENT_ID=
ECHO_GOOGLE_CLIENT_SECRET=

# Secret used to sign session cookies. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
# Changing it signs everybody out; there is no other effect.
ECHO_SESSION_SECRET=

# Public origin, used to build the OAuth redirect URI Google matches against
# its allow-list. Falls back to the request's own origin, which is wrong behind
# some proxies — set it explicitly for a real deployment.
ECHO_PUBLIC_URL=

# Where the sync database lives. Needs to be on a persistent volume; this is
# the ONLY server-side state Echo has.
ECHO_SYNC_DB_PATH=/data/echo-sync.db

# Per-account storage ceiling for the synced library, in bytes.
ECHO_MAX_SYNC_BYTES=100000000
