# Dependencies
node_modules/

# Local Claude Code / editor settings
.claude/

# Installed agent skills (local tooling, not part of the app)
.agents/
skills-lock.json

# Logs & OS cruft
*.log
npm-debug.log*
.DS_Store
Thumbs.db

# Env & secrets
.env
.env.*
!.env.example

# Scratch
scratchpad/
tmp/

# Personal library (saved transcripts)
data/

# SQLite libraries wherever they land, not just under data/. ECHO_DB_PATH can
# point anywhere, and a stray one was committed to the repo root once already
# (an empty `x`, removed in 8fbd6de). A real one holds every saved video, its
# transcript and its digest — that must never reach a public remote.
*.db
*.db-wal
*.db-shm
*.sqlite
*.sqlite3

# Private working notes — kept out of the public repo
docs/memory/

# Holesail tunnel seed (tools/holesail-serve.mjs) — this IS the serving
# capability for the public URL it derives, not a cosmetic id. Treat it like
# an API key.
.holesail-seed
