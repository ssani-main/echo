<!-- ADMIN — the access-request queue.
     A pane, like the Library, rather than a section inside the Settings modal:
     an approval queue is a place you go to do work, not a preference. Visible
     only to a DID listed in ECHO_ADMIN_DIDS; the routes 404 for everyone else,
     so this is presentation, not the security boundary.
-->
<section class="admin-pane" id="adminPane" hidden aria-labelledby="adminPaneTitle">
  <div class="admin-pane-head">
    <div>
      <h2 class="admin-pane-title" id="adminPaneTitle">People</h2>
      <p class="admin-pane-counts" id="adminCounts"></p>
    </div>
    <div class="admin-pane-controls">
      <label class="digest-opt-label" for="adminQueueFilter">Showing</label>
      <select id="adminQueueFilter">
        <option value="pending">Pending</option>
        <option value="approved">Approved</option>
        <option value="rejected">Rejected</option>
      </select>
      <button type="button" id="adminRefreshBtn" class="mini-btn">Refresh</button>
    </div>
  </div>
  <p id="adminQueueEmpty" class="settings-note" hidden>No requests here.</p>
  <div id="adminQueueList"></div>
</section>
