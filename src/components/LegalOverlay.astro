<!-- LEGAL OVERLAY (Privacy / Terms — single modal, content swapped by JS) -->
<div id="legalOverlay" role="dialog" aria-modal="true" aria-label="Legal information" hidden>
  <div class="shortcuts-backdrop" id="legalBackdrop"></div>
  <div class="shortcuts-modal">
    <div class="shortcuts-modal-header">
      <span class="shortcuts-modal-title" id="legalModalTitle">Privacy</span>
      <button class="shortcuts-close-btn" id="legalClose" aria-label="Close">×</button>
    </div>
    <div id="legalModalBody" class="legal-modal-body"></div>
  </div>
</div>
