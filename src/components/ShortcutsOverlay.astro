<!-- KEYBOARD SHORTCUTS OVERLAY -->
<div id="shortcutsOverlay" role="dialog" aria-modal="true" aria-label="Keyboard shortcuts" hidden>
  <div class="shortcuts-backdrop" id="shortcutsBackdrop"></div>
  <div class="shortcuts-modal">
    <div class="shortcuts-modal-header">
      <span class="shortcuts-modal-title">Keyboard shortcuts</span>
      <button class="shortcuts-close-btn" id="shortcutsClose" aria-label="Close shortcuts">×</button>
    </div>
    <table class="shortcuts-table">
      <tbody>
        <tr>
          <td><kbd>?</kbd></td>
          <td>Open this shortcuts overlay</td>
        </tr>
        <tr>
          <td><kbd>Esc</kbd></td>
          <td>Close overlay or popover</td>
        </tr>
        <tr>
          <td><kbd>/</kbd></td>
          <td>Focus the find-in-transcript box</td>
        </tr>
        <tr>
          <td><kbd>1</kbd></td>
          <td>Switch to Transcript lens</td>
        </tr>
        <tr>
          <td><kbd>2</kbd></td>
          <td>Switch to Digest lens</td>
        </tr>
        <tr>
          <td><kbd>3</kbd></td>
          <td>Open your Library</td>
        </tr>
        <tr>
          <td><kbd>t</kbd></td>
          <td>Toggle light / dark theme</td>
        </tr>
      </tbody>
    </table>
  </div>
</div>
