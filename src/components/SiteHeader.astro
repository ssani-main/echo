<!-- HEADER / HERO -->
<header class="site-header">
  <div class="wordmark">
    <span class="brand" aria-label="Echo">
      <svg class="brand-glyph" viewBox="0 0 28 28" width="26" height="26" aria-hidden="true" fill="none">
        <rect x="2"  y="12" width="2.4" height="4"  rx="1.2" fill="var(--signal)"/>
        <rect x="6"  y="9"  width="2.4" height="10" rx="1.2" fill="var(--signal)"/>
        <rect x="10" y="5"  width="2.4" height="18" rx="1.2" fill="var(--signal)"/>
        <rect x="14" y="10" width="2.4" height="8"  rx="1.2" fill="var(--signal-2)"/>
        <rect x="18" y="7"  width="2.4" height="14" rx="1.2" fill="var(--signal-2)"/>
        <rect x="22" y="11" width="2.4" height="6"  rx="1.2" fill="var(--signal-2)"/>
      </svg>
      <span class="brand-word">Echo</span>
    </span>

    <!-- TOP-RIGHT HEADER CLUSTER: Library destination + usage chip + theme + shortcuts -->
    <div class="header-actions">
      <!-- Admin only. The COUNT is the notification: without it nobody knows
           anyone is waiting, which is how an approval queue quietly becomes a
           wall. Hidden for everyone else. -->
      <button
        id="adminBtn"
        class="library-btn"
        type="button"
        aria-pressed="false"
        title="Access requests"
        hidden
      >
        <span class="library-btn-label">Requests</span>
        <span id="adminCount" class="library-btn-count">0</span>
      </button>
      <button
        id="libraryBtn"
        class="library-btn"
        type="button"
        aria-pressed="false"
        title="Open your library"
      >
        <svg class="library-btn-icon" width="15" height="15" viewBox="0 0 24 24" aria-hidden="true" fill="none">
          <g stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
            <rect x="3" y="3" width="14" height="14" rx="2"/>
            <path d="M8 21h11a2 2 0 0 0 2-2V8"/>
          </g>
        </svg>
        <span class="library-btn-label">Library</span>
        <span id="libraryCount" class="library-btn-count">0</span>
      </button>
      <button
        id="themeToggle"
        class="theme-toggle"
        aria-label="Switch to dark theme"
        aria-pressed="false"
        title="Toggle dark/light theme"
      ></button>
      <button
        id="settingsBtn"
        class="settings-toggle"
        aria-label="Settings"
        title="Settings — add your Anthropic API key"
        hidden
      >⚙</button>
      <button
        id="shortcutsBtn"
        class="shortcuts-toggle"
        aria-label="Keyboard shortcuts"
        title="Keyboard shortcuts (?)"
      >?</button>
    </div>
  </div>
</header>
